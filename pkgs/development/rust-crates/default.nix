# The nixpkgs-managed Rust crate set.
#
# Every crate is packaged once per semver-compatible "slot" (`1.0.228` is in
# slot `1`, `0.3.17` in `0.3`, `0.0.7` in `0.0.7`). Packages list their direct
# dependencies in `crateDeps`; the transitive closure is computed at eval time
# from the metadata in ./crates.json and handed to cargo as a directory source.
#
# The metadata is generated by maintainers/scripts/rust-crates/rust-crates.py
# and stores only what evaluation needs:
#
#   crates.json = { "<name>": { "<slot>": { v, h, d?, f? } } }
#
# with one line per crate name and one per slot, so that changes to
# neighbouring crates are separated by an unchanged line and merge cleanly.
#
#   v: version
#   h: base64 sha256 of the .crate tarball (as found in the crates.io index)
#   d: dependency edges that are always active
#   f: feature -> edges activated by that feature. Features that activate no
#      dependencies (directly or through other features) are omitted.
#
# An edge is `name@slot[!][:feature,...]`, where `!` means the dependency is
# used with `default-features = false`. A bare feature name (no `@`) refers to
# another feature of the same crate.
#
# Requirements that exclude the newest release of their slot (`=` pins, `~`,
# upper bounds) refer to a pin slot `=version` instead, stored next to the
# slot. Pins only end up in the registries of packages reaching them; cargo
# then settles on the pinned version.
#
# Weak dependency features (`name?/feature`) are stored as ordinary edges:
# cargo's dependency resolver, which generates Cargo.lock, needs the optional
# dependency for them even when nothing else enables it.
{
  lib,
  config,
  stdenvNoCC,
  linkFarm,
  writeText,
  callPackage,
}:

let
  inherit (builtins)
    elemAt
    genericClosure
    match
    ;
  inherit (lib)
    attrValues
    concatMap
    listToAttrs
    mapAttrs
    mapAttrsToList
    nameValuePair
    optional
    splitString
    ;

  overrides = callPackage ./overrides.nix { };

  # name -> slot -> metadata
  crateData = lib.importJSON ./crates.json;

  missing =
    name: slot:
    throw ''
      rustCrates: ${name}@${slot} is required but not packaged.
      Add it with: maintainers/scripts/rust-crates/rust-crates.py add ${name}@${slot}
    '';

  # Returns `null` for references to another feature of the same crate.
  parseEdge =
    s:
    let
      m = match "([^@]+)@(=[0-9A-Za-z.+-]+|[0-9.]+)(!?)(:(.*))?" s;
      marker = elemAt m 2;
      features = if elemAt m 4 == null then [ ] else splitString "," (elemAt m 4);
    in
    if m == null then
      null
    else
      {
        name = elemAt m 0;
        slot = elemAt m 1;
        features = optional (marker == "") "default" ++ features;
      };

  # A closure node is a crate slot with one active feature; `""` is the crate
  # itself (its non-optional dependencies).
  mkNode = name: slot: feature: {
    key = "${name}@${slot}#${feature}";
    inherit name slot feature;
  };

  edgeNodes = e: [ (mkNode e.name e.slot "") ] ++ map (mkNode e.name e.slot) e.features;

  # name -> slot -> { base, features.<feature> }: the closure nodes a crate
  # slot, or one of its features, leads to. Computed at most once per
  # evaluation and shared by all packages.
  successors = mapAttrs (
    name:
    mapAttrs (
      slot: entry:
      let
        toNodes = concatMap (
          item:
          let
            e = parseEdge item;
          in
          if e == null then [ (mkNode name slot item) ] else edgeNodes e
        );
      in
      {
        base = toNodes (entry.d or [ ]);
        features = mapAttrs (_: toNodes) (entry.f or { });
      }
    )
  ) crateData;

  expand =
    node:
    let
      s = successors.${node.name}.${node.slot} or (missing node.name node.slot);
    in
    if node.feature == "" then s.base else s.features.${node.feature} or [ ];

  /**
    Compute the crate slots needed to resolve a workspace whose direct
    dependencies are `crateDeps`. Feature activation is monotone, so a plain
    graph closure suffices.

    Returns a list of `{ name, slot }`.
  */
  closure =
    crateDeps:
    let
      nodes = genericClosure {
        startSet = concatMap (
          s:
          let
            e = parseEdge s;
          in
          if e == null then throw "rustCrates: malformed crate reference \"${s}\"" else edgeNodes e
        ) crateDeps;
        operator = expand;
      };
    in
    attrValues (
      listToAttrs (map (n: nameValuePair "${n.name}@${n.slot}" { inherit (n) name slot; }) nodes)
    );

  fetchurlBoot = import ../../build-support/fetchurl/boot.nix {
    inherit (config) rewriteURL;
    inherit (stdenvNoCC.buildPlatform) system;
  };

  /**
    Fetch and unpack a crate from crates.io into a directory usable as an entry
    of a cargo directory source.

    This avoids `stdenv.mkDerivation` and nixpkgs' `fetchurl`: every crate
    becomes such a derivation, so they need to be cheap to evaluate.
  */
  fetchCrateSource =
    {
      name,
      version,
      hash,
      patches ? [ ],
      postPatch ? "",
    }:
    derivation {
      name = "rust-crate-${name}-${version}";
      inherit (stdenvNoCC.buildPlatform) system;
      builder = stdenvNoCC.shell;
      args = [
        "-e"
        ./unpack-crate.sh
      ];
      src = fetchurlBoot {
        name = "${name}-${version}.tar.gz";
        url = "https://static.crates.io/crates/${name}/${version}/download";
        inherit hash;
      };
      PATH = lib.makeBinPath stdenvNoCC.initialPath;
      crateHash = lib.removePrefix "sha256-" hash;
      inherit patches postPatch;
    }
    // {
      inherit version;
      crateName = name;
    };

  crates = mapAttrs (
    name:
    mapAttrs (
      _slot: data:
      fetchCrateSource (
        {
          inherit name;
          version = data.v;
          hash = "sha256-${data.h}";
        }
        // (overrides.${name} or (_: { })) {
          inherit name;
          version = data.v;
        }
      )
    )
  ) crateData;

  registryMarker = writeText "nixpkgs-crate-registry" "";

  /**
    Build a cargo directory source containing every crate needed by
    `crateDeps`, plus `extraCrates` (directories laid out like `cargo vendor`
    entries, e.g. from `fetchCrateSource`).

    The registry contains no Cargo.lock; cargoRegistryHook generates one
    against it, and recognises the registry by the `.nixpkgs-crate-registry`
    marker.
  */
  mkRegistry =
    {
      name ? "cargo-deps",
      crateDeps,
      extraCrates ? [ ],
    }:
    linkFarm "${name}-crate-registry" (
      # A pin may have the same version as its crate's slot.
      mapAttrsToList (name: path: { inherit name path; }) (
        listToAttrs (
          map (
            { name, slot }: nameValuePair "${name}-${crateData.${name}.${slot}.v}" crates.${name}.${slot}
          ) (closure crateDeps)
        )
      )
      ++ map (src: {
        name = if lib.isDerivation src then src.name else baseNameOf src;
        path = src;
      }) extraCrates
      ++ [
        {
          name = ".nixpkgs-crate-registry";
          path = registryMarker;
        }
      ]
    );

  /**
    An update script regenerating `crateDeps` of the package being updated
    (adding or bumping crates as needed). Run it after bumping the version:

    ```nix
    passthru.updateScript = _experimental-update-script-combinators.sequence [
      (nix-update-script { })
      (rustCrates.updateScript { })
    ];
    ```
  */
  updateScript =
    {
      attrPath ? null,
    }:
    [
      "sh"
      "-c"
      "exec maintainers/scripts/rust-crates/rust-crates.py deps -A ${
        if attrPath == null then ''"$UPDATE_NIX_ATTR_PATH"'' else lib.escapeShellArg attrPath
      } --write"
    ];
in
{
  inherit
    closure
    crates
    fetchCrateSource
    mkRegistry
    updateScript
    ;
}
